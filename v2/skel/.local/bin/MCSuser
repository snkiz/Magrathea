#!/bin/bash
# Run as your normal user; it re-runs itself with sudo.
mcuser=minecraft
mchome="/opt/$mcuser"
SKEL="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
GREET="This script creates a system user and group called ${mcuser}.
It creates a directory owned by ${mcuser} where your server files live and
adds some tools. It installs a systemd service to control your servers.
It is safe to run on an existing install, and it always resets file
permissions, so you can run it again if you have permission issues."
#############################################################################
# Sudo check
if [[ $(id -u) -ne 0 ]]; then
  echo "Hello ${USER}, you are not root. We will need that. Running with sudo (Ctrl+C to exit)." >&2
  exec sudo "$0" "$@"
fi
[[ -n "$SUDO_USER" && "$SUDO_USER" != root ]] || { echo "Run this as a normal user via sudo, not as root directly." >&2; exit 1; }
echo -e "\n${SUDO_USER}, you are root.\n${GREET}"; sleep 2

# Create the user if needed, and install/update the MCS files.
echo -e "\nchecking for ${mcuser} user..."
if ! id -u "$mcuser" >/dev/null 2>&1; then
  echo "User ${mcuser} does not exist. Creating..."
  useradd -r -m -U -d "$mchome" -s /bin/bash "$mcuser" || exit 1
  install_skel=y
else
  echo "${mcuser} user found. Reinstall the MCS files (scripts, templates, eula.txt) anyway?"
  echo "Yes if this is the first time or you are updating MCS. Your instances are not touched."
  read -rp "y or n: " -n 1 install_skel; echo
fi
if [[ $install_skel =~ ^[Yy]$ ]]; then
  cp -rv "$SKEL"/. "$mchome"/
fi
mkdir -p "$mchome"/{instance,import/mods,import/config,backups/mods,backups/PlayerData,backups/instance,toolbox}
for t in MCSimport MCScreate MCSbrowse MCSconf MCSfetch MCSweb MCSbackup MCShelp; do
  ln -sfn "../.local/bin/$t" "$mchome/toolbox/$t"
done

# Install the systemd units and the polkit rule as root-owned COPIES, taken
# from the MCS files next to this script (not from $mchome, which the
# $mcuser user can write: a root install from there could be tampered with).
echo -e "
installing MCS services..."
for u in MCS@.service MCS@.socket MCSweb.service MCSbackup.service MCSbackup.timer MCSoffbox.service MCSoffbox.timer; do
  install -m 644 -o root -g root "$SKEL/.local/lib/systemd/$u" "/etc/systemd/system/$u"
done
systemctl daemon-reload
# Scheduled backups are on by default: a world is real work. Each server's time can be changed
# in the web page or with MCSbackup schedule. They only warn, stop and copy a server when its time comes.
systemctl enable --now MCSbackup.timer >/dev/null 2>&1 || echo "NOTE: could not enable the backup timer; run: sudo systemctl enable --now MCSbackup.timer"
# polkit lets the web interface start/stop MCS@* units (and nothing else).
if [[ -d /etc/polkit-1/rules.d ]]; then
  install -m 644 -o root -g root "$SKEL/.local/lib/systemd/MCS.rules" /etc/polkit-1/rules.d/50-mcs.rules
else
  echo "NOTE: polkit is not installed, so the web interface cannot start/stop servers."
  echo "      Install it (Debian/Ubuntu: sudo apt install polkitd) and run MCSuser again."
  echo "      (pkexec, the command-line part, is not needed here; desktop systems already have it.)"
fi
# Java and acl are not needed to install, but a server will not start without Java, so say so now.
if ! compgen -G "/usr/lib/jvm/*/bin/java" >/dev/null && ! command -v java >/dev/null; then
  echo "NOTE: no Java found, so a server will not start yet."
  echo "      Install it (Debian/Ubuntu: sudo apt install openjdk-21-jre-headless). Minecraft 1.20.5 and newer needs Java 21."
fi
if ! command -v setfacl >/dev/null; then
  echo "NOTE: acl is not installed. Everything works, but new files may need their group fixed;"
  echo "      running MCSuser again resets that. Install it with: sudo apt install acl"
fi

# Web login keys. MCSkey is a root-owned copy (taken from the MCS files next to this
# script, never from $mchome) and the keys live in /etc/MCS, readable by the $mcuser
# group but writable only by root. The web service can check a key but not make or
# revoke one, and neither can a mod or anyone who is only in the $mcuser group.
install -d -m 755 -o root -g root /usr/local/lib/MCS
install -m 755 -o root -g root "$SKEL/.local/lib/MCS/mcskey.py" /usr/local/lib/MCS/mcskey.py
printf '#!/bin/sh
# Added by MCSuser: run the root-owned MCSkey tool (asks for sudo itself).
exec python3 -I /usr/local/lib/MCS/mcskey.py "$@"
' > /usr/local/bin/MCSkey
chmod 755 /usr/local/bin/MCSkey
# The off-box backup copy, the same way: root-owned, so a mod or a helper cannot delete the separate copy.
# Its timer is only enabled by `sudo MCSoffbox set <folder>`.
install -m 755 -o root -g root "$SKEL/.local/lib/MCS/mcsoffbox.py" /usr/local/lib/MCS/mcsoffbox.py
printf '#!/bin/sh
# Added by MCSuser: run the root-owned MCSoffbox tool (asks for sudo itself).
exec python3 -I /usr/local/lib/MCS/mcsoffbox.py "$@"
' > /usr/local/bin/MCSoffbox
chmod 755 /usr/local/bin/MCSoffbox
install -d -m 750 -o root -g "$mcuser" /etc/MCS
[[ -f /etc/MCS/keys.json ]] && chown root:"$mcuser" /etc/MCS/keys.json && chmod 640 /etc/MCS/keys.json

# Commands on the PATH. The minecraft user gets its toolbox directory. Your own
# user gets small root-owned shims that run each tool AS minecraft through sudo,
# not the scripts themselves: mods run as minecraft and could rewrite those
# scripts, and you must never run something minecraft can edit as yourself.
cat > /etc/profile.d/mcs.sh <<PROFILE
# Added by MCSuser: MCS tools for the $mcuser user.
if [ "\$(id -un 2>/dev/null)" = "$mcuser" ]; then
  case ":\$PATH:" in *:$mchome/toolbox:*) ;; *) PATH="\$PATH:$mchome/toolbox" ;; esac
fi
PROFILE
chmod 644 /etc/profile.d/mcs.sh
for t in MCSimport MCScreate MCSbrowse MCSconf MCSfetch MCSweb MCSbackup MCShelp; do
  printf '#!/bin/sh\n# Added by MCSuser: runs the MCS tool as the %s user.\nexec sudo -u %s -H %s/toolbox/%s "$@"\n' "$mcuser" "$mcuser" "$mchome" "$t" > "/usr/local/bin/$t"
  chmod 755 "/usr/local/bin/$t"
done

# Fix PERMS
echo -e "\nSetting ${mcuser} folder permissions and adding $SUDO_USER to the $mcuser group."
chown -hR "$mcuser:$mcuser" "$mchome"
chmod -R g+rwX,o-rwx "$mchome"
find "$mchome" -type d -exec chmod g+s {} +
chmod 0770 "$mchome"/.local/bin/*
if command -v setfacl >/dev/null; then
  setfacl -Rdm u::rwX,g:"$mcuser":rwX,o::- "$mchome"
fi
usermod -aG "$mcuser" "$SUDO_USER"

echo -e "\nYour shiny new home for Minecraft is done.
Log out and back in so your new '$mcuser' group membership takes effect.
Check MCShelp or the README in $mchome. Toolbox scripts are run as the
$mcuser user: xhost +si:localuser:$mcuser to give it GUI access, then
sudo -iu $mcuser and run ~/toolbox/MCScreate to create a new instance.
MCS<tools> modify an existing instance."

echo -e "\nPrefer a browser? Start the web interface (listens on 127.0.0.1 only):
  sudo systemctl enable --now MCSweb
then make yourself a login key (shown once, made only here on the server, needs sudo):
  sudo MCSkey add <your name>
and open http://localhost:8080. Each person gets their own key: sudo MCSkey list|revoke,
and sudo MCSkey audit shows who did what. Only root can make or revoke keys."
