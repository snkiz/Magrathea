// Lets the minecraft user (which runs the MCS web interface) start, stop and
// restart ONLY the MCS@<name>.service, MCS@<name>.socket and MCSinit@<name>.service units. Nothing else.
// Deliberately absent: manage-unit-files, so it cannot enable or link units.
// Installed (root-owned copy) to /etc/polkit-1/rules.d/50-mcs.rules by MCSuser.
polkit.addRule(function(action, subject) {
    if (subject.user !== "minecraft") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        if (unit && /^(MCS@[A-Za-z0-9_-][A-Za-z0-9._-]*\.(service|socket)|MCSinit@[A-Za-z0-9_-][A-Za-z0-9._-]*\.service)$/.test(unit)) {
            return polkit.Result.YES;
        }
    }
    return polkit.Result.NOT_HANDLED;
});
